            // Special Zombie Question MUST be Q40
            { 
              q: "40. (ข้อพิเศษ) สมมุติว่าโลกแตกและแฟนของคุณ 'กลายเป็นซอมบี้' คุณจะทำอย่างไร?", 
              options: [
                  {t: "ตัดใจกำจัดทิ้งเพื่อเอาชีวิตรอดและป้องกันคนอื่นถูกทำร้าย", v: "A"}, 
                  {t: "ยอมให้กัดและกลายเป็นซอมบี้ไปด้วยกัน จะได้ไม่ต้องพรากจากกัน", v: "B"}, 
                  {t: "จับขังล่ามโซ่ไว้ก่อน แล้วพยายามหาทางรักษาไปเรื่อยๆ เผื่อมีความหวัง", v: "C"}
              ] 
            }
        ];

        let currentQuestion = 0;
        let userAnswers = new Array(40).fill(null); // Track user answers
        let isAnimating = false;

        function startQuiz() {
            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');
            renderQuestion();
            createFloatingHearts();
        }

        function renderQuestion() {
            if (currentQuestion >= questions.length) {
                showResult();
                return;
            }

            const qData = questions[currentQuestion];
            const qContainer = document.getElementById('quiz-screen');
            const optionsContainer = document.getElementById('options-container');
            
            // Update Progress
            document.getElementById('progress-text').innerText = `${currentQuestion + 1} / ${questions.length}`;
            document.getElementById('progress-bar').style.width = `${((currentQuestion + 1) / questions.length) * 100}%`;

            // Handle Back Button Visibility
            const backBtn = document.getElementById('back-btn');
            if (currentQuestion > 0) {
                backBtn.classList.remove('hidden');
            } else {
                backBtn.classList.add('hidden');
            }

            // Reset animation
            qContainer.classList.remove('fade-in');
            void qContainer.offsetWidth; // trigger reflow
            qContainer.classList.add('fade-in');

            document.getElementById('question-text').innerText = qData.q;
            optionsContainer.innerHTML = '';

            qData.options.forEach((opt, index) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn w-full text-left p-4 rounded-2xl border-2 border-pink-100 bg-white hover:bg-pink-50 text-gray-700 font-medium shadow-sm';
                
                // Highlight previously selected answer if navigating back
                if (userAnswers[currentQuestion] && userAnswers[currentQuestion].value === opt.v) {
                    btn.classList.add('border-pink-500', 'bg-pink-50');
                }

                btn.innerHTML = `<span class="inline-block w-8 h-8 bg-pink-100 text-pink-600 text-center rounded-full leading-8 mr-3 font-bold">${index + 1}</span> ${opt.t}`;
                btn.onclick = () => selectOption(opt.v, opt.t);
                optionsContainer.appendChild(btn);
            });
            isAnimating = false;
        }

        function selectOption(value, text) {
            if(isAnimating) return;
            isAnimating = true;
            
            // Store answer
            userAnswers[currentQuestion] = { value, text };
            
            currentQuestion++;
            
            setTimeout(() => {
                renderQuestion();
            }, 300); // short delay for visual feedback
        }

        function prevQuestion() {
            if(isAnimating || currentQuestion === 0) return;
            currentQuestion--;
            renderQuestion();
        }

        function showResult() {
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.remove('hidden');

            const resultTitle = document.getElementById('result-title');
            const resultDesc = document.getElementById('result-desc');
            const resultStrength = document.getElementById('result-strength');
            const resultWarning = document.getElementById('result-warning');
            const resultTips = document.getElementById('result-tips');

            // Calculate scores from userAnswers
            let scores = { A: 0, B: 0, C: 0 };
            userAnswers.forEach(ans => {
                if(ans) scores[ans.value]++;
            });

            // Determine highest score
            let maxType = 'A';
            let maxScore = scores.A;

            if (scores.B > maxScore) { maxType = 'B'; maxScore = scores.B; }
            if (scores.C > maxScore) { maxType = 'C'; maxScore = scores.C; }

            if (maxType === 'A') {
                resultTitle.innerText = '"สายไพรคติ & นักปฏิบัติ" (The Pragmatic Lover)';
                resultDesc.innerText = 'คุณเป็นคนรักที่ใช้เหตุผลนำอารมณ์ มองโลกตามความเป็นจริง โฟกัสที่ความมั่นคง อนาคต และความอยู่รอด คุณแสดงความรักผ่าน "การกระทำ" และ "การสร้างความมั่นคง" มากกว่าคำพูดหวานหู';
                resultStrength.innerText = 'พึ่งพาได้เสมอในยามวิกฤต เป็นผู้นำที่ดี มีความรับผิดชอบสูง รักจริงหวังแต่ง';
                resultWarning.innerText = 'บางครั้งอาจดูแข็งกระด้าง เย็นชา หรือละเลยความรู้สึกละเอียดอ่อนของอีกฝ่ายในบางสถานการณ์';
                resultTips.innerText = 'ชื่นชมในความพยายามและความสำเร็จของเขา แสดงความรักด้วยการสนับสนุนเป้าหมายของเขา ไม่ต้องอ้อมค้อม ต้องการอะไรให้พูดตรงๆ ด้วยเหตุผล';
            } 
            else if (maxType === 'B') {
                resultTitle.innerText = '"สายโรแมนติก & ใช้อารมณ์ความรู้สึก" (The Romantic Lover)';
                resultDesc.innerText = 'คุณคือคนรักที่ใช้หัวใจนำทาง บูชาความรัก ให้ความสำคัญกับความรู้สึก ความผูกพัน และอารมณ์มาเป็นอันดับหนึ่ง คุณใส่ใจรายละเอียดเล็กๆ น้อยๆ และต้องการการแสดงออกทางความรักที่ชัดเจน';
                resultStrength.innerText = 'โรแมนติก อบอุ่น ใส่ใจเก่ง ทำให้คู่รักรู้สึกเป็นคนพิเศษและเป็นที่รักอยู่เสมอ';
                resultWarning.innerText = 'อารมณ์อ่อนไหวง่าย อาจน้อยใจเก่ง หรือเอาความสุขของตัวเองไปผูกติดกับคู่รักมากเกินไปจนสูญเสียความเป็นตัวเอง';
                resultTips.innerText = 'บอกรักบ่อยๆ สกินชิพ (กอด/หอม) เซอร์ไพรส์ด้วยของขวัญ และที่สำคัญคือต้อง "รับฟัง" และเข้าใจอารมณ์ของเขาโดยไม่ต้องหาเหตุผลมาโต้แย้งเสมอไป';
            } 
            else {
                resultTitle.innerText = '"สายซัพพอร์ต & เพื่อนคู่คิด" (The Supporter / Best Friend Lover)';
