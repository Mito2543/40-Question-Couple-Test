            { q: "10. คุณคิดว่า 'ความหึงหวง' ในความสัมพันธ์คืออะไร?", options: [{t:"เรื่องไร้สาระ ควรเชื่อใจกัน ถ้านอกใจก็แค่เลิก", v:"A"}, {t:"การแสดงออกว่ารักมาก หวงแปลว่ายังแคร์", v:"B"}, {t:"อาการที่เกิดขึ้นได้ แต่ควรคุยกันให้เคลียร์เพื่อความสบายใจ", v:"C"}] },
            
            { q: "11. เวลาไปเดท ใครเป็นคนเลือกร้านอาหาร?", options: [{t:"คนที่หาข้อมูลหรือรีวิวมาดีที่สุด", v:"A"}, {t:"ผลัดกันเซอร์ไพรส์เลือกร้านบรรยากาศดีๆ ให้กัน", v:"B"}, {t:"ช่วยกันเลือก ถามว่าวันนี้อยากกินแนวไหน", v:"C"}] },
            { q: "12. ในวันวาเลนไทน์ คุณคาดหวังอะไร?", options: [{t:"ไม่ต้องมีอะไรพิเศษ ประหยัดเงินไว้ใช้จ่ายอย่างอื่นดีกว่า", v:"A"}, {t:"ดอกไม้ช่อโต ของขวัญ และดินเนอร์ใต้แสงเทียน", v:"B"}, {t:"แค่ได้อยู่ด้วยกัน ใช้เวลาคุณภาพร่วมกันก็พอ", v:"C"}] },
            { q: "13. แฟนคุณทำอาหารให้กิน แต่รสชาติแย่มาก คุณจะบอกเขาว่า...", options: [{t:"บอกตรงๆ ว่ารสชาติแปลกๆ คราวหน้าลองสูตรใหม่นะ", v:"A"}, {t:"ฝืนกินจนหมด และบอกว่าอร่อยเพราะเห็นความตั้งใจ", v:"B"}, {t:"บอกว่าน่ารักจังที่ทำให้กิน แต่ช่วยกันปรุงเพิ่มอีกนิดดีมั้ย", v:"C"}] },
            { q: "14. คุณยอมรับเรื่อง 'การเช็คโทรศัพท์' แฟนได้แค่ไหน?", options: [{t:"ไม่ยอมเด็ดขาด พื้นที่ส่วนตัวต้องชัดเจน", v:"A"}, {t:"เช็คได้ตลอดเวลา ไม่มีความลับต่อกัน", v:"B"}, {t:"เช็คได้ถ้ายินยอม แต่ปกติจะไม่ก้าวก่ายกันเว้นแต่มีเหตุ", v:"C"}] },
            { q: "15. ถ้าบังเอิญเจอแฟนเก่าของเขาเข้ามาทักทาย คุณจะ...", options: [{t:"ทำตัวปกติ สุภาพ และไม่เก็บมาคิดจุกจิก", v:"A"}, {t:"รู้สึกหงุดหงิด จับมือแฟนแน่นๆ เพื่อแสดงความเป็นเจ้าของ", v:"B"}, {t:"สังเกตสถานการณ์และให้สเปซเขาคุยทักทายพอประมาณ", v:"C"}] },
