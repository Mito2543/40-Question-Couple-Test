    <script>
        // Data Structure for Questions
        // A = Pragmatic, B = Romantic, C = Supportive
        const questions = [
            { q: "1. วันหยุดยาวนี้ คุณอยากทำกิจกรรมใดมากที่สุด?", options: [{t:"เคลียร์งาน/จัดบ้านให้เรียบร้อย จะได้สบายใจ", v:"A"}, {t:"จัดทริปสุดสวีท หรือดินเนอร์หรูสองต่อสอง", v:"B"}, {t:"ทำกิจกรรมอดิเรกด้วยกัน เช่น ดูซีรีส์ เล่นเกม", v:"C"}] },
            { q: "2. เมื่อมีเรื่องไม่เข้าใจกันจนเริ่มมีปากเสียง คุณมักจะ...", options: [{t:"พูดด้วยเหตุผล เอาความจริงมาคุยกันตรงๆ", v:"A"}, {t:"เงียบ ร้องไห้ หรือใช้อารมณ์เพราะรู้สึกเสียใจ", v:"B"}, {t:"ถอยคนละก้าว รอให้อารมณ์เย็นแล้วค่อยคุย", v:"C"}] },
            { q: "3. แฟนลืมวันครบรอบของคุณ คุณจะทำอย่างไร?", options: [{t:"ไม่เป็นไร แค่วันๆ นึง ไม่ค่อยซีเรียส", v:"A"}, {t:"น้อยใจมาก หวังว่าเขาจะหาทางง้อแบบจัดเต็ม", v:"B"}, {t:"เตือนเขาตรงๆ และชวนไปหาอะไรอร่อยๆ กินด้วยกัน", v:"C"}] },
            { q: "4. คุณให้ความสำคัญกับเรื่องใดในการสร้างครอบครัว?", options: [{t:"ความมั่นคงทางการเงินและหน้าที่การงาน", v:"A"}, {t:"ความรัก ความโรแมนติกที่ไม่มีวันจืดจาง", v:"B"}, {t:"ความเข้าใจ การเป็นพาร์ทเนอร์ที่ปรึกษากันได้", v:"C"}] },
            { q: "5. เวลาแฟนบ่นเรื่องงานให้ฟัง คุณมักจะตอบสนองแบบไหน?", options: [{t:"ช่วยวิเคราะห์ปัญหาและเสนอวิธีแก้ไขทันที", v:"A"}, {t:"กอด ลูบหัว ให้กำลังใจว่า 'ไม่เป็นไรนะ'", v:"B"}, {t:"รับฟังเงียบๆ เป็นเพื่อนระบาย พยักหน้าเห็นด้วย", v:"C"}] },
            { q: "6. ของขวัญแบบไหนที่คุณอยากได้จากแฟนมากที่สุด?", options: [{t:"ของที่มีประโยชน์ ใช้งานได้จริงในชีวิตประจำวัน", v:"A"}, {t:"ของขวัญแฮนด์เมด หรือของเซอร์ไพรส์ที่มีความหมาย", v:"B"}, {t:"ทริปสั้นๆ หรือประสบการณ์ที่ได้ใช้เวลาทำร่วมกัน", v:"C"}] },
            { q: "7. คุณมีวิธีการจัดการเรื่องเงินในความสัมพันธ์อย่างไร?", options: [{t:"แยกกระเป๋าชัดเจน หรือทำบัญชีรายรับรายจ่ายร่วมกันเป๊ะๆ", v:"A"}, {t:"ไม่ค่อยคิดมาก ใครมีก็จ่าย สลับๆ กันไปตามอารมณ์", v:"B"}, {t:"ตกลงกองกลางร่วมกันแบบสบายๆ ปรับเปลี่ยนได้ตามสถานการณ์", v:"C"}] },
            { q: "8. ถ้าแฟนต้องย้ายไปทำงานต่างจังหวัดหรือต่างประเทศ 1 ปี คุณจะรู้สึก...", options: [{t:"สนับสนุนเต็มที่ เป็นโอกาสที่ดีของเขา", v:"A"}, {t:"เศร้ามาก กลัวความห่างไกลจะทำให้รักจืดจาง", v:"B"}, {t:"พยายามหาทางปรับตัว วางแผนเวลาโทรหากันและไปเยี่ยม", v:"C"}] },
